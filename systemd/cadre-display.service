[Unit]
Description=Cadre photo - diaporama HDMI
# Aucune attente du réseau : l'écran s'allume le plus tôt possible (« Connexion au Wi-Fi... »).
Conflicts=getty@tty1.service

[Service]
Type=simple
User=cadre
Group=cadre
SupplementaryGroups=video render input
Environment=CADRE_DATA=/var/lib/cadre
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/cadre
ExecStart=/usr/bin/python3 -m cadre.display
Restart=always
RestartSec=3
Nice=-5

[Install]
WantedBy=multi-user.target
