[Unit]
Description=Cadre photo - admin web
After=network.target

[Service]
Type=simple
User=cadre
Group=cadre
Environment=CADRE_DATA=/var/lib/cadre
Environment=CADRE_INCOMING=/run/cadre-web/incoming
Environment=PYTHONUNBUFFERED=1
# Corps de requête bufferisés par waitress/werkzeug : en RAM aussi.
Environment=TMPDIR=/run/cadre-web
RuntimeDirectory=cadre-web
WorkingDirectory=/opt/cadre
ExecStart=/usr/bin/python3 -m cadre.web
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Traitement d'images moins prioritaire que le diaporama (transitions fluides).
Nice=10
IOSchedulingClass=idle
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
