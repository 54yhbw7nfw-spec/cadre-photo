[Unit]
Description=Cadre photo - admin web
After=network.target

[Service]
Type=simple
User=cadre
Group=cadre
Environment=CADRE_DATA=/var/lib/cadre
Environment=CADRE_INCOMING=/run/cadre-web/incoming
Environment=PYTHONUNBUFFERED=1
# Corps de requête bufferisés par waitress/werkzeug : sur la carte (une vidéo de 2 min ne
# tiendrait pas dans /run, limité à ~40 Mo) ; dossier vidé au démarrage de l'admin.
Environment=TMPDIR=/var/lib/cadre/tmp
RuntimeDirectory=cadre-web
WorkingDirectory=/opt/cadre
ExecStart=/usr/bin/python3 -m cadre.web
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Traitement d'images moins prioritaire que le diaporama (transitions fluides).
Nice=10
IOSchedulingClass=idle
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
